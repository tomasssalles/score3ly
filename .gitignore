# `npm run screenshots` writes here.
/screenshots/

# Test set: commit only the inputs, their highlighter strokes, the LilyPond, MusicXML and MEI candidates and the README.
# Engravings and anything else produced in the folder stay local.
/testset/*
!/testset/README.md
!/testset/*.orig.pdf
!/testset/*.orig.marks.jsonl
!/testset/*.ly
!/testset/*.musicxml
!/testset/*.mei

# The list of models and prices: the whole downloads of step 1 (apps/worker/model-list/gather/README.md); only excerpts are committed.
/apps/worker/model-list/gather/downloads/
# Your Cloudflare account's config, copied from apps/worker/wrangler.template.jsonc on install and completed by
# `npm run setup:cloudflare` (apps/worker/scripts/config.ts).
/apps/worker/wrangler.jsonc
