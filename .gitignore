node_modules/
dist/
# The desktop app's packages (`npm run package -w apps/desktop`).
release/
.wrangler/
.dev.vars*

# `npm run screenshots` writes here.
/screenshots/

# Test set: commit only the inputs, their highlighter strokes, the LilyPond, MusicXML and MEI candidates and the README.
# Engravings and anything else produced in the folder stay local.
/testset/*
!/testset/README.md
!/testset/*.orig.pdf
!/testset/*.orig.marks.jsonl
!/testset/*.ly
!/testset/*.musicxml
!/testset/*.mei

# The list of models and prices: the whole downloads of step 1 (apps/worker/model-list/gather/README.md); only excerpts are committed.
/apps/worker/model-list/gather/downloads/
# The Worker's Wrangler configs, generated from apps/worker/wrangler.jsonc.template before every use, and your
# Cloudflare account's parts, written by `npm run setup:cloudflare` (apps/worker/scripts/config.ts).
/apps/worker/wrangler.local-dev.jsonc
/apps/worker/wrangler.deploy.jsonc
/apps/worker/wrangler.fill-call-places.jsonc
/apps/worker/cloudflare.env
