{
  "name": "score3ly",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "migrate:local": "npm run migrate:local -w apps/worker",
    "build": "npm run build -w apps/web",
    "deploy": "npm run build && npm run deploy -w apps/worker",
    "eval:engrave": "npm run engrave -w apps/eval",
    "eval:view": "npm run view -w apps/eval",
    "test": "npm test --workspaces --if-present && node --test \"scripts/*.test.ts\"",
    "icons": "npm run icons -w apps/web",
    "notices": "node scripts/notices.ts",
    "screenshots": "node scripts/screenshots.ts",
    "seed:costs": "node scripts/seedCosts.ts",
    "desktop": "npm run start -w apps/desktop",
    "serve": "npm run serve -w apps/desktop",
    "package:desktop": "npm run package -w apps/desktop"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild@0.28.2": true,
    "protobufjs": false,
    "core-js@3.51.0": true,
    "electron-winstaller@5.4.0": true,
    "workerd@1.20261019.1": true
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    },
    "@electron/get": {
      "undici": "^7.30.1"
    }
  }
}
