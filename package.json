{
  "name": "score3ly",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "migrate:local": "npm run migrate:local -w apps/worker",
    "build": "npm run build -w apps/web",
    "deploy": "npm run build && npm run deploy -w apps/worker",
    "eval:engrave": "npm run engrave -w apps/eval",
    "eval:view": "npm run view -w apps/eval",
    "test": "npm test --workspaces --if-present"
  }
}
