{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/config.ts",
    "dev": "node scripts/config.ts && mkdir -p ../web/dist && wrangler dev",
    "deploy": "node scripts/config.ts && wrangler d1 migrations apply score3ly --remote && wrangler deploy",
    "setup:cloudflare": "node scripts/setup-cloudflare.ts",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply score3ly --local",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/*.test.ts\"",
    "llm:try": "node scripts/try-llm.ts",
    "llm:probe-schemas": "node scripts/probe-schemas.ts",
    "model-list": "node scripts/generate-model-list.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/genai": "^2.28.0",
    "@score3ly/core": "*",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.153.0"
  }
}
